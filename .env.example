# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or slow (free tier). Empty = no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Nano Banana model for studio photos. Image models have no free tier:
# set GEMINI_IMAGE_ENABLED=true only once billing is enabled on the Gemini project.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENABLED=false

# Public URL encoded in menu QR codes (e.g. https://your-domain.vn). Defaults to the request host.
NEXT_PUBLIC_SITE_URL=

# AI calls per day for all shops together (protects the shared free-tier quota). Default 300.
AI_DAILY_GLOBAL_LIMIT=300

# Shown on /terms and /privacy as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=
